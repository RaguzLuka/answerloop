# Copy to .env.local for local development. Everything is optional locally.

# Database — leave unset locally to use a SQLite file in .data/.
# Production: a Turso (libSQL) database, ideally in an EU region.
# DATABASE_URL=libsql://ringloop-<you>.turso.io
# DATABASE_AUTH_TOKEN=

# Public URL of this app (booking links, emails, Twilio webhook address)
# NEXT_PUBLIC_APP_URL=https://app.ringloop.net

# Comma-separated emails that can open /admin
# ADMIN_EMAILS=hello@ringloop.net

# Twilio — text-backs, confirmations, reminders, routing pool numbers.
# Without the SID, texts are printed to the server console instead of sent.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Fallback sender when a business has no sender name (optional)
# TWILIO_SMS_FROM=RingLoop
# Max texts per business per 24 h (default 150)
# SMS_DAILY_LIMIT=150

# Daily reminder job (Vercel sends it as a Bearer token)
# CRON_SECRET=

# Halo's AI booking chat (Pro plan). OFF unless AI_ENABLED is exactly "true".
# AI_ENABLED=true
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Max customer chat messages per business per 24 h (default 300)
# AI_DAILY_LIMIT=300

# WhatsApp (Meta Cloud API) — Pro shops message missed callers on WhatsApp first.
# Each shop's own number (Phone number ID, account ID, optional token) is connected in /admin.
# WHATSAPP_TOKEN=            System User token that can reach the shops' WhatsApp accounts
# WHATSAPP_APP_SECRET=       Meta app → Settings → Basic (verifies webhook signatures)
# APP_ENCRYPTION_KEY=        openssl rand -base64 32 (encrypts shops' tokens in the database)
# WHATSAPP_VERIFY_TOKEN=     any long random string, also typed into the Meta webhook settings
# WHATSAPP_TEMPLATE_HR=missed_call_hr
# WHATSAPP_TEMPLATE_EN=missed_call_en
# Development only: print WhatsApp messages instead of sending them
# WHATSAPP_DRY_RUN=true

# Self-service "Connect WhatsApp" (Meta Embedded Signup — needs RingLoop approved as a Meta Tech Provider)
# NEXT_PUBLIC_META_APP_ID=
# NEXT_PUBLIC_META_CONFIG_ID=  WhatsApp Embedded Signup configuration ID (Facebook Login for Business)

# Self-service "Connect Google Calendar" (Google Cloud OAuth client, Web application)
# Redirect URI: https://app.ringloop.net/api/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Development only: fake Google (daily 13:00-14:00 busy, writes printed)
# GOOGLE_DRY_RUN=true

# Phone notifications (web push). Generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@ringloop.net

# Email via Resend — without a key, emails are printed to the server console instead
# RESEND_API_KEY=
# RESEND_FROM=RingLoop <app@ringloop.net>
# TEAM_INBOX=hello@ringloop.net
